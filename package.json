{
	"name": "@adraffy/ens-normalize.ts",
	"version": "1.0.1",
	"description": "ENSIP-15 ENS Name Normalizer in TypeScript (zero dependencies)",
	"keywords": ["ENS", "ENSIP-15", "Ethereum", "UTS-46", "Normalize", "NFC", "NFD"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adraffy/ens-normalize.ts.git"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./xnf": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/xnf.js",
			"require": "./dist/xnf.cjs"
		},
		"./full": {
			"types": "./dist/types/full.d.ts",
			"import": "./dist/full.js",
			"require": "./dist/full.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"download": "bun scripts/download.ts --force",
		"make": "bun scripts/make.ts",
		"build": "bun scripts/build.ts",
		"test": "bun test",
		"test:labels": "bun test/labels.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"terser": "^5.51.2",
		"typescript": "^7.0.2"
	}
}
